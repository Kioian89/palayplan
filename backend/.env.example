# --- Database ---
DATABASE_URL=mysql+pymysql://palayplan_user:password@localhost:3306/palayplan_db

# --- Weather API ---
OPENWEATHER_API_KEY=your_openweathermap_api_key_here
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/3.0

# --- Auth ---
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- ML ---
MODEL_ARTIFACT_PATH=app/ml/model_artifact/yield_model.joblib

# --- Firebase (optional, if using Firebase instead of MySQL) ---
FIREBASE_CREDENTIALS_PATH=firebase-service-account.json
