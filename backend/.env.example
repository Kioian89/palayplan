# ─────────────────────────────────────────────────────────────────────────────
# PalayPlan Backend — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# For local development, SQLite is used automatically when DATABASE_URL is empty.
# For production, use a MySQL or PostgreSQL URL:
#   mysql+pymysql://user:password@host:3306/palayplan_db
#   postgresql+asyncpg://user:password@host:5432/palayplan_db
DATABASE_URL=

# ── Weather API ───────────────────────────────────────────────────────────────
# OpenWeatherMap API key (optional — app falls back to Open-Meteo if empty).
# Get a free key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=

# ── Authentication ────────────────────────────────────────────────────────────
# Secret key used to sign JWT tokens. Generate a strong random string:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=changeme_use_a_strong_random_secret

# JWT algorithm (default: HS256)
JWT_ALGORITHM=HS256

# Token expiry in minutes (default: 60)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
# Path to your Firebase Admin SDK service account JSON file.
# Download from Firebase Console → Project Settings → Service Accounts.
# Leave empty to skip Firebase token verification (guest-only mode).
FIREBASE_CREDENTIALS_PATH=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for CORS (used in production).
# Example: https://app.palayplan.com,https://www.palayplan.com
ALLOWED_ORIGINS=*

# ── ML Model ──────────────────────────────────────────────────────────────────
# Path to the trained joblib yield prediction model file.
# If empty, the heuristic fallback (_heuristic_predict) is used automatically.
YIELD_MODEL_PATH=

# ── App Environment ───────────────────────────────────────────────────────────
# Set to "production" to disable debug outputs and enable stricter security.
APP_ENV=development
